{
  "dataset": "forecasts",
  "transform": {
    "groupby": {
      "by": ["date"],
      "agg": {"forecast_net_adds": "sum"}
    }
  },
  "chart": {
    "kind": "area",
    "x": "date",
    "y": "forecast_net_adds"
  },
  "style": {
    "title": "Forecast Net Adds per Day (all segments)",
    "xlabel": "Date",
    "ylabel": "Net adds",
    "figsize": [10, 5],
    "legend": false
  },
  "output": "net_adds_forecast.png"
}
