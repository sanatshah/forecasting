{
  "dataset": "metrics",
  "transform": {
    "filters": [
      {"col": "level", "op": "eq", "value": "acquisition_channel"},
      {"col": "target", "op": "eq", "value": "gross_adds"}
    ],
    "groupby": {
      "by": ["group"],
      "agg": {"wape": "min"}
    },
    "sort": {"by": "wape", "ascending": true}
  },
  "chart": {
    "kind": "barh",
    "x": "group",
    "y": "wape"
  },
  "style": {
    "title": "Best WAPE by Acquisition Channel (gross adds)",
    "xlabel": "WAPE",
    "figsize": [9, 5],
    "legend": false
  },
  "output": "wape_by_channel.png"
}
