{
  "dataset": "forecasts",
  "transform": {
    "groupby": {
      "by": ["date"],
      "agg": {"forecast_units": "sum"}
    }
  },
  "chart": {
    "kind": "area",
    "x": "date",
    "y": "forecast_units"
  },
  "style": {
    "title": "Forward Forecast Demand Over Time (all series)",
    "xlabel": "Date",
    "ylabel": "Total forecast units",
    "figsize": [10, 5],
    "legend": false
  },
  "output": "forecast_distribution.png"
}
