{
  "dataset": "recommendations",
  "transform": {
    "filters": [
      {"col": "forecast_horizon", "op": "eq", "value": 28}
    ],
    "groupby": {
      "by": ["reason_code"],
      "agg": {"count": "size"}
    },
    "sort": {"by": "count", "ascending": false}
  },
  "chart": {
    "kind": "bar",
    "x": "reason_code",
    "y": "count"
  },
  "style": {
    "title": "Segment Recommendations by Reason Code (28-day)",
    "ylabel": "Segments",
    "figsize": [9, 5],
    "tick_rotation": 30,
    "legend": false
  },
  "output": "recommendation_summary.png"
}
