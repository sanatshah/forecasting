{
  "dataset": "metrics",
  "transform": {
    "filters": [
      {"col": "level", "op": "eq", "value": "department"}
    ],
    "groupby": {
      "by": ["group"],
      "agg": {"mae": "mean"}
    },
    "sort": {"by": "mae", "ascending": true}
  },
  "chart": {
    "kind": "barh",
    "x": "group",
    "y": "mae"
  },
  "style": {
    "title": "Forecast Error (MAE) by Department",
    "xlabel": "MAE (units)",
    "figsize": [9, 5],
    "legend": false
  },
  "output": "error_by_department.png"
}
